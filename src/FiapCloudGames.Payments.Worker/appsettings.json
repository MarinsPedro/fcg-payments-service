{
  "RabbitMq": {
    "Host": "127.0.0.1",
    "Port": 5672,
    "VirtualHost": "/",
    "Topology": {
      "Exchanges": {
        "PaymentRequested": "payments.payment-requested.v1",
        "PaymentApproved": "payments.payment-approved.v1",
        "PaymentRejected": "payments.payment-rejected.v1"
      },
      "Queues": {
        "PaymentRequested": "fcg-payments-payment-requested"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 2
  }
}
