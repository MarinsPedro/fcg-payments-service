{
  "RabbitMq": {
    "Host": "127.0.0.1",
    "Port": 5672,
    "VirtualHost": "/",
    "Topology": {
      "Exchanges": {
        "PaymentRequested": "payments.payment-requested.v1",
        "PaymentApproved": "payments.payment-approved.v1",
        "PaymentRejected": "payments.payment-rejected.v1"
      },
      "Queues": {
        "PaymentRequested": "fcg-payments-payment-requested"
      }
    }
  },
  "Authentication": {
    "Issuer": "fiap-cloud-games-identity",
    "Audience": "payments-api",
    "AllowedTokenUses": [
      "service"
    ],
    "RequireHttpsMetadata": true,
    "ClockSkew": "00:00:30"
  },
  "FakePaymentProvider": {
    "ApprovalRate": 90
  },
  "AllowedHosts": "*"
}
